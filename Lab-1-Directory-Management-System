#include <iostream>
#include <string>
#include <filesystem>
#include <cstdlib>

using namespace std;
namespace fs = std::filesystem;

/* ---------- HELPER: RESOLVE WINDOWS SPECIAL FOLDERS ---------- */
fs::path resolveWindowsFolder(const string& input) {
    const char* user = getenv("USERPROFILE");
    if (!user) return fs::path(input);

    fs::path base(user);

    if (input == "My Videos" || input == "Videos")     return base / "Videos";
    if (input == "My Music"  || input == "Music")      return base / "Music";
    if (input == "My Pictures" || input == "Pictures") return base / "Pictures";
    if (input == "Documents") return base / "Documents";
    if (input == "Desktop")   return base / "Desktop";
    if (input == "Downloads") return base / "Downloads";

    return fs::path(input); // fallback for full paths
}

/* ---------- MENUS ---------- */
void mainMenu() {
    cout << "[1] List Files\n";
    cout << "[2] Create Directory\n";
    cout << "[3] Change Directory\n";
    cout << "[4] Exit\n";
    cout << "Enter option: ";
}

void listFilesMenu() {
    cout << "[1] List All Files\n";
    cout << "[2] List Files by Extension (e.g., .txt)\n";
    cout << "[3] List Files by Pattern (e.g., moha*.*)\n";
    cout << "Enter choice: ";
}

/* ---------- LIST FILES ---------- */
void listFiles() {
    int choice;
    listFilesMenu();

    while (!(cin >> choice)) {
        cin.clear();
        cin.ignore(1000, '\n');
        cout << "Invalid input. Enter a number: ";
    }
    cin.ignore();

    try {
        if (choice == 1) {
            cout << "\nFiles in current directory:\n";
            for (const auto& entry : fs::directory_iterator(fs::current_path())) {
                cout << "- " << entry.path().filename().string() << endl;
            }
        }
        else if (choice == 2) {
            string ext;
            cout << "Enter extension (e.g., .txt): ";
            getline(cin, ext);

            bool found = false;
            for (const auto& entry : fs::directory_iterator(fs::current_path())) {
                if (entry.path().extension() == ext) {
                    cout << entry.path().filename().string() << endl;
                    found = true;
                }
            }
            if (!found) cout << "No files found.\n";
        }
        else if (choice == 3) {
            string pattern;
            cout << "Enter file pattern (e.g., moha*): ";
            getline(cin, pattern);

            string prefix = pattern.substr(0, pattern.find('*'));
            bool found = false;

            for (const auto& entry : fs::directory_iterator(fs::current_path())) {
                string name = entry.path().filename().string();
                if (name.rfind(prefix, 0) == 0) {
                    cout << name << endl;
                    found = true;
                }
            }
            if (!found) cout << "No files found.\n";
        }
        else {
            cout << "Invalid choice!\n";
        }
    }
    catch (const fs::filesystem_error& e) {
        cerr << "Filesystem error: " << e.what() << endl;
    }
}

/* ---------- CREATE DIRECTORY ---------- */
void createDirectory() {
    cout << "\nEnter new directory name: ";
    string name;
    getline(cin, name);

    fs::path dir(name);

    try {
        if (fs::exists(dir))
            cout << "Directory already exists.\n";
        else if (fs::create_directory(dir))
            cout << "Directory created successfully.\n";
        else
            cout << "Failed to create directory.\n";
    }
    catch (const fs::filesystem_error& e) {
        cerr << e.what() << endl;
    }
}

/* ---------- CHANGE DIRECTORY ---------- */
void changeDirectory() {
    int choice;
    cout << "\nChange Directory Menu\n";
    cout << "[1] Move to Parent Directory\n";
    cout << "[2] Move to Root Directory\n";
    cout << "[3] Enter Custom Path / Folder Name\n";
    cout << "Enter choice: ";

    while (!(cin >> choice)) {
        cin.clear();
        cin.ignore(1000, '\n');
        cout << "Invalid input. Enter a number: ";
    }
    cin.ignore();

    try {
        if (choice == 1) {
            fs::current_path(fs::current_path().parent_path());
            cout << "Now in: " << fs::current_path() << endl;
        }
        else if (choice == 2) {
            fs::current_path(fs::current_path().root_path());
            cout << "Now in: " << fs::current_path() << endl;
        }
        else if (choice == 3) {
            cout << "Enter folder or custom path: ";
            string input;
            getline(cin, input);

            fs::path p = resolveWindowsFolder(input);

            if (fs::exists(p) && fs::is_directory(p)) {
                fs::current_path(p);
                cout << "Changed to directory: " << fs::current_path() << endl;
            }
            else {
                cout << "Error: Directory not found!\n";
            }
        }
        else {
            cout << "Invalid choice!\n";
        }
    }
    catch (const fs::filesystem_error& e) {
        cerr << "Filesystem error: " << e.what() << endl;
    }
}

/* ---------- MAIN LOOP ---------- */
void mainMenuLoop() {
    int choice;
    do {
        mainMenu();
        while (!(cin >> choice)) {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "Invalid input. Enter a number: ";
        }
        cin.ignore();

        switch (choice) {
        case 1: listFiles(); break;
        case 2: createDirectory(); break;
        case 3: changeDirectory(); break;
        case 4: cout << "Exiting program.\n"; break;
        default: cout << "Invalid option.\n";
        }
    } while (choice != 4);
}

int main() {
    mainMenuLoop();
    return 0;
}
